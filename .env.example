# Copy to .env and edit for this machine.

# Slurm only: selects slurm/clusters/<CLUSTER>.env (copy example.env to start).
CLUSTER=example

# Large disk for caches; HF_HOME, UV_CACHE_DIR and VLLM_CACHE_ROOT derive from it.
CACHE_ROOT=/path/to/your/cache

# Without Slurm only (from `nvidia-smi -L`): the agent's default GPU and the vLLM server's GPU.
# Under Slurm, jobs resolve their own GPUs.
AGENT_GPU_UUID=GPU-00000000-0000-0000-0000-000000000000
VLLM_GPU_UUID=GPU-00000000-0000-0000-0000-000000000000

# For gated HF repos (e.g. meta-llama/Llama-3.1-8B-Instruct) and faster downloads.
HF_TOKEN=your-hf-token

# Only for the claude-sonnet-5 tier (billed). Passed to the sandbox via --env-file.
# Check it with scripts/production/test_claude_call.py.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional vLLM server overrides (defaults in brackets):
# VLLM_GPU_MEM_UTIL=                  # vLLM memory fraction [tier default, else 0.97]
# VLLM_EXTRA_ARGS=                    # extra `vllm serve` flags
# VLLM_ENABLE_PREFIX_CACHING=1
# VLLM_TUNED_CONFIG_FOLDER=           # tuned MoE kernel configs to mount
# HF_HUB_OFFLINE=                     # 1: serve from the HF cache without network access
