# Cluster profile template. Copy to slurm/clusters/<name>.env, fill in your cluster's values and
# set CLUSTER=<name> in .env. Read by run_grid_slurm.py and the sbatch scripts; run_grid_slurm.py's
# CLI flags override these values.

# Leave empty if your association needs no --account.
SLURM_ACCOUNT=
# GPU partition for the vLLM server and worker jobs.
SLURM_PARTITION=gpu
# QoS for server and worker jobs; empty omits --qos.
SERVER_QOS=
WORKER_QOS=
# Partition and QoS for the short teardown and sweep jobs (a CPU partition if available).
TEARDOWN_PARTITION=cpu
TEARDOWN_QOS=

# {n} is replaced by the GPU count, e.g. gpu:{n} or gpu:h100:{n}.
GRES_TEMPLATE=gpu:{n}

# Server --time; empty uses vllm_server.sbatch's 24h default. Set it if your partition's limit is lower.
SERVER_TIME=

# Where Apptainer builds the vLLM image: cache_root ($CACHE_ROOT) or local (node-local $TMPDIR,
# better if $CACHE_ROOT is a slow network filesystem and /tmp is large).
APPTAINER_TMPDIR_MODE=cache_root

# 1 if jobs must allocate whole nodes: workers are then packed GPUS_PER_NODE per node, and small
# tiers run as data-parallel replicas on the server node. GPUS_PER_NODE and CORES_PER_NODE must
# then be set; they are unused otherwise.
WHOLE_NODE_ONLY=0
GPUS_PER_NODE=8
CORES_PER_NODE=

# Port range for the vLLM server; restrict it if only some ports are open between nodes.
VLLM_PORT_RANGE_START=60001
VLLM_PORT_RANGE_SIZE=3000

# Extra sbatch flags if jobs must request internet access (e.g. --comment=INTERNET_ACCESS=1).
# Servers need it to download images and weights; workers need it for web_fetch.
SERVER_NEEDS_INTERNET_FLAG=
WORKER_NEEDS_INTERNET_FLAG=

# nvccli (default; restricts the container to one GPU or MIG slice) or nv (for setuid Apptainer
# installations, where --nvccli is not allowed).
APPTAINER_GPU_FLAG=nvccli

# QoS for --preemptible worker arrays (preemptible jobs, resubmitted by sweep_grid_slurm.py).
PREEMPTIBLE_QOS=
